{
    "name": "bizprofile/framework",
    "description": "BizProfile - A comprehensive business management framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "BizProfile Team",
            "email": "contact@bizprofile.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-session": "*",
        "ext-mbstring": "*",
        "ext-imagick": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "vimeo/psalm": "^4.0",
        "squizlabs/php_codesniffer": "^3.6",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/php-code-coverage": "^9.0",
        "phpunit/php-timer": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "BizProfile\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BizProfile\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "post-install-cmd": "[ -f vendor/bin/phpunit ] && vendor/bin/phpunit --version || true",
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "test-coverage": "vendor/bin/phpunit --coverage-text --coverage-clover clover.xml",
        "test-security": "vendor/bin/phpunit tests/ -k security",
        "test-integration": "vendor/bin/phpunit tests/ -k integration",
        "quality-check": "vendor/bin/phpcs --standard=PSR12 includes/ && vendor/bin/phpstan analyse includes/",
        "stan": "vendor/bin/phpstan analyse includes/",
        "psalm": "vendor/bin/psalm",
        "fix-style": "vendor/bin/php-cs-fixer fix includes/ --allow-risky",
        "build": "rm -rf storage && mkdir -p storage && echo 'Build completed'"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.org"
        }
    ]
}