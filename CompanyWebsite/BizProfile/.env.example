APP_NAME=BizProfile
APP_ENV=production
APP_DEBUG=false
APP_KEY=your-secret-key-here

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bizprofile
DB_USERNAME=root
DB_PASSWORD=

MAIL_DRIVER=phpmailer
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@datachron.in
MAIL_FROM_NAME="${APP_NAME}"

CACHE_DRIVER=file
SESSION_DRIVER=file

GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# M1 - Owner Provisioning & Setup
# Authorized owner email is provisioned via CLI (php bin/bizprofile owner:provision --email=...)
# and stored as a keyed hash in the database - NOT in this file
SETUP_EMAIL_PEPPER=change-this-to-a-secure-random-string
OTP_PEPPER=change-this-to-a-secure-random-string
INSTANCE_ID=